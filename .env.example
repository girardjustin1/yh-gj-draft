# Fantasy Draft AI — environment overrides. Copy to .env; .env is gitignored.
# Nothing here is required for the local-only MVP.

# Override the project data directory (default: ./data)
# FF_DATA_DIR=./data

# Override the DuckDB path (default: <data dir>/fantasy.duckdb)
# FF_DB_PATH=./data/fantasy.duckdb

# Override the config directory (default: ./config)
# FF_CONFIG_DIR=./config

# Log level: DEBUG | INFO | WARNING | ERROR (default: WARNING)
# FF_LOG_LEVEL=INFO
